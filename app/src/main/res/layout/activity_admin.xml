<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#16213e"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF"
            android:layout_marginEnd="12dp"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Panel"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFD700"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ShopEasy Management"
                android:textSize="11sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#16213e">

        <TextView
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊 Dashboard"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#FFD700"
            android:background="#0D47A1"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tab_products"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📦 Products"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#AAAAAA"/>

        <TextView
            android:id="@+id/tab_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛒 Orders"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#AAAAAA"/>
    </LinearLayout>

    <!-- Tab content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== DASHBOARD TAB ===== -->
            <LinearLayout
                android:id="@+id/panel_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Store Overview"
                    android:textSize="16sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="12dp"/>

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#16213e"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_stat_users"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#6C63FF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Users"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardBackgroundColor="#16213e"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_stat_orders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#4ECDC4"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orders"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#16213e"
                        app:cardCornerRadius="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_stat_revenue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FFD700"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenue"
                                android:textSize="12sp"
                                android:textColor="#AAAAAA"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Quick links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_go_products"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Manage Products"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6C63FF"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btn_go_orders"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="View All Orders"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#4ECDC4"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== PRODUCTS TAB ===== -->
            <LinearLayout
                android:id="@+id/panel_products"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➕ Add New Product"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_image_url"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="🖼️ Image URL (paste from Google Images)"
                    android:background="#2d2d44"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textUri"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btn_preview_image"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="👁 Preview Image"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4ECDC4"
                    android:layout_marginBottom="8dp"/>

                <ImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="#2d2d44"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Product Name"
                    android:background="#2d2d44"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_product_desc"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Description"
                    android:background="#2d2d44"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="top"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_product_price"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Price (₹)"
                    android:background="#2d2d44"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinner_category"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="#2d2d44"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/et_product_rating"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="Rating (0-5)"
                        android:background="#2d2d44"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="numberDecimal"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/et_product_stock"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="Stock Qty"
                        android:background="#2d2d44"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="number"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_add_product"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADD PRODUCT"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6C63FF"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 All Products"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/ll_products_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- ===== ORDERS TAB ===== -->
            <LinearLayout
                android:id="@+id/panel_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒 All Customer Orders"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/ll_orders_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
