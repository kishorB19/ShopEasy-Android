<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#16213e"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_back_cart"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Cart 🛒"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_cart_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="🛒\n\nYour cart is empty!\nStart shopping now."
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Bottom Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#16213e"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_cart_grand_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grand Total: ₹0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4ECDC4"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_checkout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="PROCEED TO CHECKOUT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C63FF"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
