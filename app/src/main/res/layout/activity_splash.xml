<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1a1a2e"
    android:fitsSystemWindows="true">

    <!-- Logo icon from drawable -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="#16213e"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <!-- Shopping bag shape using ImageView with our vector logo -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ShopEasy"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"/>

    <!-- Purple underline accent -->
    <View
        android:layout_width="60dp"
        android:layout_height="4dp"
        android:background="#6C63FF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your one-stop shopping destination"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_marginTop="4dp"/>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:indeterminateTint="#6C63FF"/>

</LinearLayout>
